# Dev stack (deploy/dev). Load with: set -a; source .env; set +a
ROR_DATABASE_URL=postgresql+psycopg://roracle:roracle@localhost:55433/roracle
ROR_S3_ENDPOINT=http://localhost:9000
ROR_S3_BUCKET=roracle
ROR_S3_ACCESS_KEY=minioadmin
ROR_S3_SECRET_KEY=minioadmin
ROR_OIDC_ISSUER=http://localhost:8080/realms/roracle
ROR_OIDC_AUDIENCE=roracle
ROR_OIDC_JWKS_URL=http://localhost:8080/realms/roracle/protocol/openid-connect/certs
ROR_OIDC_ALLOWED_CLIENTS=roracle-web,roracle-mcp
ROR_MAX_UPLOAD_BYTES=524288000
# Ingest. 11434 is a local Ollama; 21434 is an SSH tunnel to a GPU box running Ollama
# (embeddinggemma + qwen2.5:14b).
ROR_ELASTIC_URL=http://localhost:9200
ROR_LLM_BASE_URL=http://localhost:21434/v1
ROR_LLM_API_KEY=unused
ROR_LLM_TIMEOUT_S=120
ROR_EMBED_MODEL=embeddinggemma
ROR_EMBED_DIMS=768
ROR_EMBED_TOKENIZER=sentence-transformers/all-MiniLM-L6-v2
ROR_SUMMARY_MODEL=qwen2.5:14b
ROR_DOCLING_URL=http://localhost:5001
ROR_DOCLING_TIMEOUT_S=300
ROR_GROBID_TIMEOUT_S=120
# Empty = stage skipped. Start with: docker compose --profile full up -d grobid clamav
ROR_GROBID_URL=
ROR_CLAMAV_HOST=
ROR_NEAR_DUP_THRESHOLD=0.85
# Optional reranker (empty URL disables); POST {model, query, documents} -> results[{index, relevance_score}]
ROR_RERANK_URL=
ROR_RERANK_MODEL=
