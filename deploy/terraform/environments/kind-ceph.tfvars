# kind LIVE Rook-Ceph rehearsal (test/kind-e2e.sh ceph). Local only: needs loop devices (privileged kind node), ~16 GB RAM.
# OSD devices (`ceph = {...}`) are generated by the script into test/.tools/ceph-osd.tfvars (loop devices are dynamic).
kubeconfig_path    = "test/.tools/kubeconfig"
kubeconfig_context = "kind-rorac-kind"

mirror_registry = "localhost:5055"
ha              = false
protect_data    = true

charts = {
  cnpg         = { repository = "oci://localhost:5055/charts", version = "0.26.0" }
  barman       = { repository = "oci://localhost:5055/charts", version = "0.9.0" }
  cert_manager = { repository = "oci://localhost:5055/charts", version = "v1.17.0" }
  eck          = { repository = "oci://localhost:5055/charts", version = "2.16.0" }
  rook_ceph    = { repository = "oci://localhost:5055/charts", version = "v1.18.0", values = "allowLoopDevices: true\n" } # test only: OSDs on loop devices
  rook_ceph_cluster = {
    repository = "oci://localhost:5055/charts", version = "v1.18.0"
    # test only (single host): the default CRUSH rule (used by .mgr and .rgw.root) must pick OSDs, not hosts, or those PGs stay undersized
    values = "configOverride: |\n  [global]\n  osd_crush_chooseleaf_type = 0\n"
  }
}

operator_images = {
  cnpg         = { tag = "1.26.0" }
  barman       = { tag = "v0.16.0", sidecar_tag = "v0.16.0" }
  cert_manager = { tag = "v1.17.0" }
  eck          = { tag = "2.16.0" }
  rook_ceph    = { tag = "v1.18.0" }
}

images = {
  registry = "localhost:5055"
}

object_store = "rook-ceph"
# `ceph` (1 mon/1 mgr/1 RGW, failure domain osd, EC 2+1 on 3 loop OSDs, self-signed TLS via cert-manager) comes from the generated file.
# backups_enabled stays at the default (both on): CNPG barman and ES snapshots run against the locked RGW buckets.

extra_values_file = "environments/kind-values.yaml"

ingress = { enabled = false }
keycloak = {
  issuer = "https://keycloak.kind.invalid/realms/research"
}
models = {
  llm_base_url = "http://llm.kind.invalid/v1"
  chat_models  = "kind-none"
  embed_model  = "kind-none"
  embed_dims   = 768
  llm_key_used = false
}

storage = { postgres = "2Gi", elasticsearch = "2Gi" }

helm_timeout_s = 1800
